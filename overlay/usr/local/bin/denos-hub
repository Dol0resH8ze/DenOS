#!/usr/bin/python3
"""DenOS native welcome and privacy application (GTK 3)."""
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib
import json
import os
import subprocess
import threading

ASSETS = '/usr/share/denos'
CSS = b'''
window { background: #11151d; color: #eef2f8; }
.sidebar { background: #0c1017; border-right: 1px solid #242b37; }
.brand { font-size: 27px; font-weight: 800; letter-spacing: -1px; }
.muted { color: #929dad; font-size: 12px; }
.eyebrow { color: #8edcc8; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
.hero { font-size: 43px; font-weight: 800; letter-spacing: -1px; }
.subtitle { font-size: 14px; color: #aab5c4; }
.section { font-size: 21px; font-weight: 700; }
.card { background: #1a202b; border: 1px solid #2a3342; border-radius: 12px; padding: 16px; }
.cardtitle { font-weight: 700; font-size: 14px; }
.status { color: #9fe8d4; font-size: 11px; font-weight: 700; }
.nav { background: transparent; border: none; box-shadow: none; color: #aeb7c6; padding: 12px 14px; border-radius: 8px; }
.nav:checked, .nav:hover { background: #202b38; color: #b3eedf; }
.action { background: #9ce2cf; color: #10231e; border: none; border-radius: 8px; padding: 12px 18px; font-weight: 700; box-shadow: none; text-shadow: none; }
.action:hover { background: #b9f3e2; }
.secondary { background: #242d3b; color: #e5edf7; border: 1px solid #354153; border-radius: 8px; padding: 10px 16px; box-shadow: none; text-shadow: none; }
.secondary:hover { background: #303d4e; }
.danger { color: #efc5a1; font-size: 12px; }
separator { background: #2b3442; }
'''

def label(text, style=None, wrap=False):
    w = Gtk.Label(label=text)
    w.set_xalign(0)
    if wrap:
        w.set_line_wrap(True)
        w.set_max_width_chars(66)
    if style:
        w.get_style_context().add_class(style)
    return w

def box(vertical=True, spacing=0, margin=0):
    w = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=spacing)
    w.set_border_width(margin)
    return w

def button(text, callback, primary=False):
    w = Gtk.Button(label=text)
    w.get_style_context().add_class('action' if primary else 'secondary')
    w.connect('clicked', callback)
    return w

class Hub(Gtk.Window):
    def __init__(self):
        super().__init__(title='DenOS · Your space, your rules')
        self.set_default_size(950, 660)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_from_file(ASSETS + '/denos.svg')
        self.connect('destroy', Gtk.main_quit)
        self.live = os.path.exists('/run/live/medium')
        self.state = {}
        self.busy = False
        self.status_labels = {}
        self.navs = {}
        self.navigating = False
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        layout = box(False)
        self.add(layout)
        sidebar = box(spacing=8, margin=23)
        sidebar.set_size_request(206, -1)
        sidebar.get_style_context().add_class('sidebar')
        logo = Gtk.Image.new_from_file(ASSETS + '/denos.svg')
        logo.set_pixel_size(44)
        brandrow = box(False, 12)
        brandrow.pack_start(logo, False, False, 0)
        brandrow.pack_start(label('DenOS', 'brand'), False, False, 0)
        sidebar.pack_start(brandrow, False, False, 7)
        sidebar.pack_start(label('A QUIETER DESKTOP', 'eyebrow'), False, False, 8)
        spacer = box(margin=6)
        sidebar.pack_start(spacer, False, False, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        for key, title, icon in [('home','Overview','go-home-symbolic'), ('privacy','Privacy center','security-high-symbolic'), ('apps','Your applications','view-grid-symbolic'), ('install','Install DenOS','drive-harddisk-symbolic'), ('about','About DenOS','help-about-symbolic')]:
            nav = Gtk.ToggleButton()
            row = box(False, 12)
            row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON), False, False, 0)
            row.pack_start(label(title), False, False, 0)
            nav.add(row)
            nav.get_style_context().add_class('nav')
            nav.connect('clicked', lambda w, k=key: self.navigate(k))
            sidebar.pack_start(nav, False, False, 0)
            self.navs[key] = nav
        sidebar.pack_start(box(), True, True, 0)
        sidebar.pack_start(label('0.1  /  FIRST LIGHT', 'muted'), False, False, 0)
        sidebar.pack_start(label('Debian foundation.\nDenOS personality.', 'muted'), False, False, 4)
        layout.pack_start(sidebar, False, False, 0)
        layout.pack_start(self.stack, True, True, 0)
        self.make_home()
        self.make_privacy()
        self.make_apps()
        self.make_install()
        self.make_about()
        self.navigate('home')
        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)
        self.show_all()

    def navigate(self, key):
        if self.navigating:
            return
        self.navigating = True
        self.stack.set_visible_child_name(key)
        for name, nav in self.navs.items():
            nav.set_active(name == key)
        self.navigating = False

    def page(self, key, eyebrow, heading, subtitle):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content = box(spacing=18, margin=35)
        content.pack_start(label(eyebrow, 'eyebrow'), False, False, 0)
        content.pack_start(label(heading, 'hero'), False, False, 0)
        content.pack_start(label(subtitle, 'subtitle', True), False, False, 0)
        scroll.add(content)
        self.stack.add_named(scroll, key)
        return content

    def card(self, title, text, icon=None):
        c = box(spacing=9)
        c.get_style_context().add_class('card')
        if icon:
            row = box(False, 10)
            row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            row.pack_start(label(title, 'cardtitle'), False, False, 0)
            c.pack_start(row, False, False, 0)
        else:
            c.pack_start(label(title, 'cardtitle'), False, False, 0)
        c.pack_start(label(text, 'muted', True), False, False, 0)
        return c

    def make_home(self):
        c = self.page('home', 'WELCOME TO YOUR OWN SPACE', 'Less noise.\nMore you.', 'A calm desktop with privacy-minded defaults.\nEverything you need. Room to make it yours.')
        row = box(False, 12)
        row.pack_start(button('Open privacy center  →', lambda _: self.navigate('privacy'), True), False, False, 0)
        row.pack_start(button('Explore files', lambda _: self.launch(['thunar'])), False, False, 0)
        c.pack_start(row, False, False, 6)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        a = self.card('A fresh start', 'This live session uses temporary memory. Restarting clears unsaved session changes.' if self.live else 'DenOS is installed. Files in your home folder now stay on disk.', 'computer-symbolic')
        a.pack_start(label('LIVE · TEMPORARY' if self.live else 'INSTALLED · PERSISTENT', 'status'), False, False, 3)
        b = self.card('You choose connection', 'Networking starts off. Connect deliberately from the privacy center.', 'network-offline-symbolic')
        self.status_labels['home-network'] = label('CHECKING…', 'status')
        b.pack_start(self.status_labels['home-network'], False, False, 3)
        grid.attach(a, 0, 0, 1, 1)
        grid.attach(b, 1, 0, 1, 1)
        c.pack_start(grid, False, False, 0)
        c.pack_start(label('NATIVE LINUX DESKTOP  /  NO DENOS ANALYTICS', 'eyebrow'), False, False, 4)

    def make_privacy(self):
        c = self.page('privacy', 'PRIVACY, WITH CLARITY', 'Your space.\nYour rules.', 'Real controls, straightforward defaults. No made-up privacy scores.')
        card = self.card('Network access', 'Offline mode blocks outbound traffic and disables NetworkManager. Enabling access allows apps to connect; it does not provide anonymity.', 'network-wireless-symbolic')
        self.status_labels['network'] = label('Checking network…', 'status')
        card.pack_start(self.status_labels['network'], False, False, 0)
        self.network_button = button('Enable network access', self.toggle_network, True)
        self.network_button.set_halign(Gtk.Align.START)
        card.pack_start(self.network_button, False, False, 5)
        c.pack_start(card, False, False, 0)
        for name, title, desc in [
            ('firewall', 'Firewall', 'Unsolicited inbound connections are blocked. Loopback and established traffic are permitted.'),
            ('browser', 'Private browsing', 'Firefox telemetry and studies are disabled by policy. Private browsing and strict tracking protection are defaults.'),
            ('storage', 'Session storage', 'Live changes are held in RAM. Files saved to mounted USB drives or disks remain there.' if self.live else 'Installed files persist. This first installer uses an unencrypted ext4 filesystem.'),
        ]:
            row = box(spacing=6)
            row.get_style_context().add_class('card')
            top = box(False, 12)
            top.pack_start(label(title, 'cardtitle'), True, True, 0)
            val = label('CHECKING' if name == 'firewall' else ('POLICY SET' if name == 'browser' else ('RAM SESSION' if self.live else 'DISK STORAGE')), 'status')
            self.status_labels[name] = val
            top.pack_end(val, False, False, 0)
            row.pack_start(top, False, False, 0)
            row.pack_start(label(desc, 'muted', True), False, False, 0)
            c.pack_start(row, False, False, 0)
        c.pack_start(label('DenOS is an early Linux remix. It has not undergone an independent security audit.', 'muted', True), False, False, 0)

    def make_apps(self):
        c = self.page('apps', 'A SMALL, USEFUL TOOLBOX', 'Ready to work.', 'Native applications. Familiar essentials. A clean starting point.')
        for title, desc, icon, cmd in [
            ('Firefox ESR', 'Browse with privacy-minded defaults.', 'firefox-esr', ['firefox-esr']),
            ('Files', 'Manage your home folder and external drives.', 'system-file-manager', ['thunar']),
            ('Terminal', 'A real Linux shell, with the full Debian toolchain available.', 'utilities-terminal', ['xfce4-terminal']),
            ('Notes', 'A simple, distraction-free text editor.', 'accessories-text-editor', ['mousepad']),
            ('Desktop settings', 'Make your desktop feel like yours.', 'preferences-desktop', ['xfce4-settings-manager']),
        ]:
            r = box(False, 14)
            r.get_style_context().add_class('card')
            r.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), False, False, 0)
            text = box(spacing=4)
            text.pack_start(label(title, 'cardtitle'), False, False, 0)
            text.pack_start(label(desc, 'muted', True), False, False, 0)
            r.pack_start(text, True, True, 0)
            r.pack_end(button('Open', lambda _, command=cmd: self.launch(command)), False, False, 0)
            c.pack_start(r, False, False, 0)

    def make_install(self):
        c = self.page('install', 'MAKE YOURSELF AT HOME', 'Take DenOS\nwith you.', 'Try the live desktop first. Install when you are ready for a permanent home.')
        card = self.card('Guided disk installer', 'The installer runs in a terminal and lets you choose a target disk. It shows the disk details and requires an exact erase confirmation before changing anything.', 'drive-harddisk-symbolic')
        card.pack_start(label('Installation erases the entire selected disk.\nThis release does not encrypt the installed filesystem.\nBack up your files before proceeding.', 'danger', True), False, False, 0)
        launch = button('Open installer', lambda _: self.launch(['xfce4-terminal','--hold','--title=Install DenOS','--command=sudo /usr/local/sbin/denos-install']), True)
        launch.set_halign(Gtk.Align.START)
        launch.set_sensitive(self.live)
        card.pack_start(launch, False, False, 7)
        c.pack_start(card, False, False, 0)
        c.pack_start(self.card('Before you begin', '64-bit Intel / AMD PC · 4 GB RAM recommended\n20 GB disk minimum · UEFI or legacy BIOS\nSecure Boot must be disabled for this unsigned image.'), False, False, 0)

    def make_about(self):
        c = self.page('about', 'FIRST LIGHT / VERSION 0.1', 'Meet DenOS.', 'An independent, privacy-minded Linux remix built on Debian 13 and the Xfce desktop.')
        c.pack_start(self.card('What is real', 'A bootable Linux kernel, native desktop, working applications, offline control, firewall rules, and Firefox privacy policies. DenOS itself sends no analytics.'), False, False, 0)
        c.pack_start(self.card('What to expect', 'This is an experimental first release. Test in a virtual machine first. Hardware support depends on the included Debian drivers; proprietary Wi-Fi and GPU firmware is not included. There is no anonymity network or automatic encrypted storage.'), False, False, 0)
        c.pack_start(self.card('Built in the open', 'Linux, Debian, Xfce, Firefox and all included software retain their own licenses. DenOS customizations are MIT licensed. Source, build scripts and notices accompany the image.'), False, False, 0)
        c.pack_start(button('Read the local guide', lambda _: self.launch(['mousepad', ASSETS + '/README.txt'])), False, False, 0)

    def launch(self, command):
        try:
            subprocess.Popen(command, start_new_session=True)
        except Exception as exc:
            self.message('Could not open application', str(exc))

    def message(self, title, text, question=False):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION if question else Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK_CANCEL if question else Gtk.ButtonsType.OK, text=title)
        d.format_secondary_text(text)
        result = d.run()
        d.destroy()
        return result == Gtk.ResponseType.OK

    def refresh(self):
        if self.busy:
            return True
        def worker():
            try:
                p = subprocess.run(['sudo','-n','/usr/local/sbin/denos-control','status'], capture_output=True, text=True, timeout=8)
                data = json.loads(p.stdout) if p.returncode == 0 else {}
            except Exception:
                data = {}
            GLib.idle_add(self.apply_status, data)
        threading.Thread(target=worker, daemon=True).start()
        return True

    def apply_status(self, state):
        self.state = state
        online = state.get('network') == 'enabled'
        known = state.get('network') in ('enabled','disabled')
        self.status_labels['network'].set_text('ACCESS ENABLED' if online else ('OFFLINE MODE' if known else 'STATUS UNAVAILABLE'))
        self.status_labels['home-network'].set_text('NETWORK ENABLED' if online else ('OFFLINE BY DEFAULT' if known else 'STATUS UNAVAILABLE'))
        self.network_button.set_label('Go offline' if online else 'Enable network access')
        self.network_button.set_sensitive(known and not self.busy)
        self.status_labels['firewall'].set_text('ACTIVE' if state.get('firewall') else 'CHECK REQUIRED')
        return False

    def toggle_network(self, _):
        enabled = self.state.get('network') == 'enabled'
        if not enabled and not self.message('Enable network access?', 'Applications will be able to contact the internet. The firewall will continue to block unsolicited inbound connections. Use the network icon to choose Wi-Fi after enabling access.', True):
            return
        self.busy = True
        self.network_button.set_sensitive(False)
        self.network_button.set_label('Applying…')
        def work():
            try:
                p = subprocess.run(['sudo','-n','/usr/local/sbin/denos-control','offline' if enabled else 'online'], capture_output=True, text=True, timeout=25)
                error = (p.stderr or p.stdout).strip() if p.returncode else ''
            except Exception as exc:
                error = str(exc)
            GLib.idle_add(self.network_done, error)
        threading.Thread(target=work, daemon=True).start()

    def network_done(self, error):
        self.busy = False
        if error:
            self.message('Network setting could not be applied', error)
        self.refresh()
        return False

if __name__ == '__main__':
    Hub()
    Gtk.main()
